# 旧Phase-1の加算型マスク(未使用・巨大ファイル数)。生成器 generate.py で再生成可
stroke_mask_images/
stroke_mask_images_*/
recordings_raw/

# 話者選びのための合成音の候補(4話者×68字)。1話者を選んだら残りは捨てるので入れない。
# build_tts_candidates.py で作り直せる。聴き比べは tools/tts_voice_compare.html に
# 音を埋め込んであるので、リポジトリだけで聴ける。
experiment/tts_candidates/
# 2026-08-23: AivisSpeech/COEIROINK候補・カバーフレーズ試作の合成音(同じ理由で除外)。
# 採用した話者(花音)の本番用打ち切り版は experiment/transfer_stimuli_kanon/ に別途コミット済み。
experiment/tts_candidates_aivis/
experiment/tts_candidates_carrier/
experiment/tts_candidates_coeiroink/

# Firestore の管理者用の鍵(サービスアカウント)。**本物の秘密**。
# これがあれば全データを読めるし消せるので、絶対にコミットしない。
# 解析のとき(experiment/tools/export_transfer_firestore.py)だけ使う。
# 参加者のブラウザが使うウェブAPIキーとは性質が違う(あちらは公開前提・
# transfer_config.js に入れてある)。
firebase/*-sa.json
firebase/service-account*.json
*-firebase-adminsdk-*.json
.firebase/
firebase-debug.log

# Firebase Hosting に上げるファイルを集めた置き場。
# experiment/tools/build_hosting.sh が作り直すだけのもので、中身はすべて
# experiment/ からのコピーなので git には入れない(音声約7MBの二重管理を避ける)。
hosting_dist/

# 作り直しで置き換わった旧版の音声（ローカルにだけ残す。スクリプトで再生成できる）
#   _rejected_acc0            … 全字 accent=0 版（却下。経緯は project/刺激作成_キャリアフレーズ.md §4.4）
#   _superseded               … 由来を特定できなかった中間フォルダ
#   _superseded_transfer_*_pa … 後続音「ぱ」版の544本（旧配信物）
experiment/tts_candidates_carrier2/_rejected_acc0/
experiment/tts_candidates_carrier2/_superseded/
experiment/_superseded_transfer_stimuli_amitaro_pa/
experiment/_superseded_transfer_audio_manifest_amitaro_pa.json

# 監視ツール（watch_transfer.py）が「前回どこまで見たか」を控えるファイル。
# 実行するたびに変わるだけで、記録として残す意味がない。
experiment/tools/.watch_transfer_state.json

